# Google OAuth 2.0 Client ID (from Google Cloud Console -> Credentials)
# Authorized JavaScript origin: http://localhost:5173 (+ your deployed frontend origin)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Secret used to sign the app's own session JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Database URL.
#   local dev : sqlite:///./latte.db
#   production: postgres://USER:PASS@HOST:5432/DBNAME   (Render / Neon / Supabase)
# `postgres://` and `postgresql://` are auto-upgraded to the psycopg driver.
DATABASE_URL=sqlite:///./latte.db

# Comma-separated allowed CORS origins.
#   local dev : http://localhost:5173
#   production: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173
