# Google OAuth 2.0 Client ID (from Google Cloud Console -> Credentials)
# Authorized JavaScript origin: http://localhost:5173
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Secret used to sign the app's own session JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# SQLite database file path
DATABASE_URL=sqlite:///./latte.db

# Comma-separated allowed CORS origins (the Vite dev server)
CORS_ORIGINS=http://localhost:5173
