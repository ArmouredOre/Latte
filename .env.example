# Copy this file to .env.local and fill in real values.
# Vite only exposes vars prefixed with VITE_ to browser code (import.meta.env).

# Base URL of the FastAPI backend
VITE_API_URL=http://localhost:8000

# Google OAuth 2.0 Client ID — MUST match backend/.env GOOGLE_CLIENT_ID.
# Create one at https://console.cloud.google.com/apis/credentials
# (Web application, Authorized JavaScript origin: http://localhost:5173)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
